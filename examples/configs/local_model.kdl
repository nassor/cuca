// A `LocalModelConfig` for the `local_model` example. Run it with:
//
//   cargo run --release --example local_model --features provider-local -- --config examples/configs/local_model.kdl --prompt "Say hi"
//
// Every key is a field of `cuca::LocalModelConfig`; only `source` is active,
// the others show the syntax and are commented out.

source "qwen3-0.6b-q8_0"                 // or: source file="/models/x.gguf" | source dir="/ckpt" | source "repo:revision" | source "repo:revision:file"
// source { checkpoint repo="Qwen/Qwen3-0.6B" revision="c1899de"; }
// source { hugging_face repo="org/r" revision="abc" file="m.gguf" sha256="..." { part file="..." sha256="..."; template repo="..." revision="..." file="chat_template.jinja"; } }
// device "vulkan:0"
// shards "vulkan:1"
// gpu_layers 20
// context_length 8192
// cache_dir "D:/cuca-cache"
// hf_token "${HF_TOKEN:-}"
// chat_template_file "templates/x.jinja"
// sampling temperature=0.7 top_k=40 top_p=0.9 seed=7
// batching max_sequences=8 kv_tokens=16384 max_step_tokens=256 prefix_cache=#false
// experts { tiered ram_bytes="4g" device_bytes="6g" loader_threads=8; }   // or: experts "resident" | experts { host layers=4; } | experts { host; }
// engram ram_bytes="2g" reader_threads=8
// convert quant="q4_0" engram_quant="q8_0"   // quant: f16 | q8_0 (default) | q4_0 | q4_k_s | q4_k_m | q5_k_m | q6_k
// drafter "in-trunk"                       // or a source in any form above
// draft_tokens 5
// shard_dirs "E:/parts" "F:/parts"
// kv_export max_exports=2                  // serve K/V rows of prompts to decode nodes (a bare `kv_export` takes the default 2); not with shards or stages
// remote_stage url="http://box-a:8000" layers=14   // coordinator: layers 0..14 run on that worker; repeat the node per worker, in layer order
// remote_stage url="http://box-b:8000" layers=10 model="m" api_key="${STAGE_KEY:-}" timeout="600s" carry="bf16"   // model: its name on that server; carry: the type hidden states travel in ("f32" bit-exact, the default; "bf16" and "f16" halve the bytes and are not bit-exact); the rest of the layers and the head run on this model's device
// stage first=0 layers=14                  // worker: this model holds only these layers and serves stage calls, no chat; not with a drafter

// Hybrid placement: a model larger than the GPU or RAM spreads over VRAM, RAM
// and the GGUF file on the SSD. To use a recipe, replace the active `source`
// above with its keys.
//
// Dense model, 38 of 52 layers on the GPU and the first 14 on the CPU:
//   source "muse-glimmer-30b-q4_0"
//   device "vulkan"
//   gpu_layers 38
//
// Mixture of experts on the GPU, 4 GiB of experts in VRAM, 12 GiB in RAM and
// the rest read from the file on demand:
//   source "qwen3.6-35b-a3b-q4_0"
//   device "vulkan"
//   experts { tiered device_bytes="4g" ram_bytes="12g"; }
//
// Attention on the GPU, every routed expert in RAM and computed by the CPU:
//   source "mistral-small-4-119b-q4_0"
//   device "vulkan"
//   experts { host; }
//
// Attention on the GPU, experts on the SSD behind an 85 GiB RAM tier that the
// CPU computes from (host-tiered), the Engram rows behind a 4 GiB cache:
//   source "deepseek-ai/DeepSeek-V4.1-Flash-1017:<revision>"
//   device "vulkan"
//   experts { tiered ram_bytes="85g" loader_threads=32; }
//   engram ram_bytes="4g" reader_threads=16
