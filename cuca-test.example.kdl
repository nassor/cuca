// The test configuration. Copy this file to `cuca-test.kdl` (gitignored) in
// the repository root and edit it; every live and oracle test reads its
// settings from there, none from the environment. Without the file every live
// test prints `SKIP:` and passes. A `//` line is a key left at its default.

// A skip (no server, no model, no oracle) fails the test instead.
require_live #false

// The model cache of every test that downloads or converts; the platform
// cache directory (%LOCALAPPDATA%\cuca, ~/.cache/cuca, ...) when absent.
// cache_dir "D:/cuca-cache"

// The llama.cpp server of the plugin and service suites (build them with the
// `config-kdl` feature next to `provider-llamacpp` to read this file).
llamacpp base_url="http://127.0.0.1:1234/v1"
// llamacpp base_url="http://127.0.0.1:1234/v1" model="google/gemma-4-e4b"

// The in-process model of tests/provider_local*.rs.
local {
    // `model` is a `cuca::LocalModelConfig`, written with its field names
    // (examples/configs/local_model.kdl shows every key).
    model {
        source "qwen3-0.6b-q8_0"
        // source file="/models/Qwen3.5-0.8B-Q8_0.gguf" | source dir="/ckpt" | source "repo:revision"
        // device "vulkan:0"
        // shards "vulkan:0"                 // tensor parallelism on one GPU
        // gpu_layers 20
        // context_length 8192
        // hf_token "${HF_TOKEN:-}"
        // chat_template_file "template.jinja"
        // batching max_sequences=4 kv_tokens=16384
        // experts { tiered ram_bytes="4g"; }
        // engram ram_bytes="2g" reader_threads=8
        // convert quant="f16"
        // drafter "gemma4-e2b-mtp-f16"      // or "in-trunk", or file="..."
    }
    // Without a `source`, download and run the default preset.
    // download_default #true
    // provider_local_tiers.rs: the placement the tiered run is compared with.
    // experts_ref { tiered ram_bytes="1g"; }
    // provider_local_mtp.rs: one comparison per draft length.
    // draft_tokens 1 2 3 4
    // allow_mismatch #true
    // Print each greedy reply as a `REPLY|...` line.
    // print_replies #true
    // provider_local.rs: the long-prompt speed scenario, optionally cold.
    // perf #true
    // perf_cold #true
}

// Oracle dumps and real-model files of the local engine's unit tests.
oracle {
    // ref_dir ".omp/local-models/ref"           // transformers oracle dumps
    // convert_only "Qwen"
    // ref_tol 5e-4
    // ref_ckpt "/ckpt/Qwen3-0.6B"
    // ref_gguf "/models/x.gguf"
    // ref_prefix ".omp/local-models/ref/local/qwen3"
    // convert_probe "blk.0.attn_q.weight"
    // dflash_ref ".omp/local-models/ref/dflash"
    // catalog_dir "D:/cuca-cache/huggingface"
    // tok_gguf "/models/x.gguf"
    // tok_cases ".omp/local-models/ref/tok/cases.json"
    // tok_max_diff 0
    // mistral4_gguf "/models/Mistral-Small-4-119B-Q4_0.gguf"
    ds41 {
        // oracle_dir ".omp/local-models/ref/ds41"
        // tokenizer_ref_dir ".omp/local-models/ref/deepseek-v41"
        // tokenizer_json ".omp/local-models/ref/deepseek-v41/tokenizer.json"
        // real_dir ".omp/local-models/ref/ds41-real"
        // real_ram_gib 90
        // real_gpu_layers 20
        // real_ctx 4096
        // real_seqs 4
        // real_rows 256
        // real_speed #true
        // real_paths #true
        // real_qdq #true
        // real_dump_dir "target/ds41-logits"
    }
    g4moe {
        // oracle_dir ".omp/local-models/ref/g4moe"
        // real "/models/gemma-4-26B-A4B-it-Q4_0.gguf"
        // real_ref ".omp/local-models/ref/g4moe/real.json"
        // trunc "/models/gemma-4-26B-A4B-trunc.gguf"
        // trunc_ref ".omp/local-models/ref/g4moe/trunc.json"
    }
}
